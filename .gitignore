*.png
*.jpg
*.jpeg
*.webp
*.gif
*.tif
*.tiff
*.psd
*.exr
# Model weights and archives
*.safetensors
*.ckpt
*.pt
*.pth
*.bin
*.onnx
*.gguf
*.bundle
*.tar
*.tar.gz
*.zip

# Local job output, if someone points a job directory inside the worktree
/jobs/
/out/
/output/

# Secrets and local environment
.env
.env.*
*.key
*.pem
.venv/
venv/

# Python
__pycache__/
