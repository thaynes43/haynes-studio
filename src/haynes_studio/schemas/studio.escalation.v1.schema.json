{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haynes-studio.invalid/schemas/studio.escalation.v1.schema.json",
  "title": "Immutable Studio escalation request",
  "type": "object",
  "properties": {
    "schema": {
      "const": "studio.escalation/v1"
    },
    "deduplication_id": {
      "$ref": "#/$defs/digest"
    },
    "production_id": {
      "$ref": "studio.defs.v1.schema.json#/$defs/prd_id"
    },
    "story_id": {
      "$ref": "studio.defs.v1.schema.json#/$defs/sty_id"
    },
    "run_id": {
      "$ref": "studio.defs.v1.schema.json#/$defs/run_id"
    },
    "snapshot_sha256": {
      "$ref": "#/$defs/digest"
    },
    "board_ids": {
      "type": "array",
      "items": {
        "$ref": "studio.defs.v1.schema.json#/$defs/brd_id"
      },
      "minItems": 0,
      "maxItems": 1,
      "uniqueItems": true
    },
    "failure": {
      "type": "object",
      "properties": {
        "check": {
          "enum": [
            "layered.decal_gate",
            "mix.length",
            "mix.loudness",
            "mix.true_peak",
            "mix.clipping",
            "master.loudness",
            "master.true_peak",
            "master.clipping",
            "master.transcript"
          ]
        },
        "input_sha256": {
          "$ref": "#/$defs/digest"
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "operation": {
                "const": "get_escalation_check"
              },
              "record_sha256": {
                "$ref": "#/$defs/digest"
              }
            },
            "required": [
              "operation",
              "record_sha256"
            ],
            "additionalProperties": false
          },
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        }
      },
      "required": [
        "check",
        "input_sha256",
        "results"
      ],
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "operation": {
            "const": "get_media"
          },
          "sha256": {
            "$ref": "#/$defs/digest"
          }
        },
        "required": [
          "operation",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true
    },
    "allowed_actions": {
      "type": "array",
      "items": {
        "enum": [
          "get_escalation_check",
          "get_media",
          "studio_get_story_summary",
          "studio_get_board",
          "studio_patch_board",
          "studio_queue_run"
        ]
      },
      "minItems": 3,
      "maxItems": 6,
      "uniqueItems": true
    },
    "patch_fields": {
      "type": "array",
      "items": {
        "enum": [
          "layout",
          "seeds",
          "timing",
          "title"
        ]
      },
      "minItems": 0,
      "maxItems": 4,
      "uniqueItems": true
    },
    "forbidden_actions": {
      "const": [
        "go_live",
        "promotion",
        "deletion",
        "other_story",
        "other_production",
        "check_override",
        "cancel_run"
      ]
    },
    "usage_cap": {
      "type": "object",
      "properties": {
        "seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 900
        },
        "queued_runs": {
          "enum": [
            0,
            1
          ]
        }
      },
      "required": [
        "seconds",
        "queued_runs"
      ],
      "additionalProperties": false
    },
    "expires_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$",
      "maxLength": 27,
      "format": "date-time"
    },
    "responder_key": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^key_0000000000[0-9A-HJKMNP-TV-Z]{16}$",
          "maxLength": 30
        },
        "production_id": {
          "$ref": "studio.defs.v1.schema.json#/$defs/prd_id"
        },
        "scopes": {
          "type": "array",
          "items": {
            "enum": [
              "read",
              "draft:write",
              "runs:queue"
            ]
          },
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "production_id",
        "scopes"
      ],
      "additionalProperties": false
    },
    "callback": {
      "type": "object",
      "properties": {
        "method": {
          "const": "POST"
        },
        "operation": {
          "const": "report_escalation"
        },
        "idempotency_header": {
          "const": "Idempotency-Key"
        },
        "outcomes": {
          "const": [
            "done",
            "failed",
            "escalate"
          ]
        }
      },
      "required": [
        "method",
        "operation",
        "idempotency_header",
        "outcomes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "deduplication_id",
    "production_id",
    "story_id",
    "run_id",
    "snapshot_sha256",
    "board_ids",
    "failure",
    "artifacts",
    "allowed_actions",
    "patch_fields",
    "forbidden_actions",
    "usage_cap",
    "expires_at",
    "responder_key",
    "callback"
  ],
  "additionalProperties": false,
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "maxLength": 64
    }
  },
  "if": {
    "properties": {
      "board_ids": {
        "minItems": 1
      }
    }
  },
  "then": {
    "properties": {
      "allowed_actions": {
        "const": [
          "get_escalation_check",
          "get_media",
          "studio_get_story_summary",
          "studio_get_board",
          "studio_patch_board",
          "studio_queue_run"
        ]
      },
      "patch_fields": {
        "const": [
          "layout",
          "seeds",
          "timing",
          "title"
        ]
      },
      "responder_key": {
        "properties": {
          "scopes": {
            "const": [
              "read",
              "draft:write",
              "runs:queue"
            ]
          }
        }
      },
      "usage_cap": {
        "properties": {
          "queued_runs": {
            "const": 1
          }
        }
      }
    }
  },
  "else": {
    "properties": {
      "allowed_actions": {
        "const": [
          "get_escalation_check",
          "get_media",
          "studio_get_story_summary"
        ]
      },
      "patch_fields": {
        "const": []
      },
      "responder_key": {
        "properties": {
          "scopes": {
            "const": [
              "read"
            ]
          }
        }
      },
      "usage_cap": {
        "properties": {
          "queued_runs": {
            "const": 0
          }
        }
      }
    }
  }
}
