{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haynes-studio.invalid/schemas/studio.run-snapshot.v1.schema.json",
  "title": "studio.run-snapshot/v1: the story a run builds, by value (contract section 8)",
  "description": "The story with its boards embedded, every asset version the build reads pinned by content hash (or definition_signature for a voice, input_signature and take hashes for a board voice), and the toolchain the run was asked for. It holds no run ID and no time of the run, so the same draft always gives the same canonical bytes and hash. The story's own fields are checked by studio.story/v1.",
  "type": "object",
  "required": [
    "schema",
    "story",
    "resolved_asset_versions",
    "toolchain_request"
  ],
  "properties": {
    "schema": {
      "const": "studio.run-snapshot/v1",
      "x-studio": {
        "const": {
          "rule": "schema.unsupported",
          "message": "must be studio.run-snapshot/v1"
        }
      }
    },
    "story": {
      "type": "object",
      "required": [
        "schema",
        "id",
        "boards",
        "board_order"
      ]
    },
    "resolved_asset_versions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "sha256"
        ],
        "properties": {
          "id": {
            "$ref": "studio.defs.v1.schema.json#/$defs/asv_id"
          },
          "kind": {
            "enum": [
              "cast",
              "costume",
              "prop",
              "set",
              "photo",
              "motion",
              "sound",
              "voice",
              "board_voice",
              "character_card"
            ]
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "definition_signature": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "input_signature": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "take_sha256": {
            "type": "array",
            "items": {
              "$ref": "studio.defs.v1.schema.json#/$defs/sha256"
            },
            "minItems": 1
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "voice"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "definition_signature"
              ],
              "properties": {
                "sha256": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "board_voice"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "input_signature",
                "take_sha256"
              ],
              "properties": {
                "sha256": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "not": {
                    "enum": [
                      "voice",
                      "board_voice"
                    ]
                  }
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "sha256": {
                  "$ref": "studio.defs.v1.schema.json#/$defs/sha256"
                },
                "definition_signature": false,
                "input_signature": false,
                "take_sha256": false
              }
            }
          }
        ]
      }
    },
    "toolchain_request": {
      "type": "object",
      "required": [
        "studio"
      ],
      "properties": {
        "studio": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
          },
          "x-studio": {
            "not": {
              "message": "must not contain control characters"
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
