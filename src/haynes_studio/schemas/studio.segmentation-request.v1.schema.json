{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haynes-studio.invalid/schemas/studio.segmentation-request.v1.schema.json",
  "title": "Studio segmentation request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile",
    "input",
    "target",
    "hint"
  ],
  "properties": {
    "schema": {
      "const": "studio.segmentation-request/v1"
    },
    "profile": {
      "enum": [
        "grounding-dino-tiny-sam2.1-tiny-cpu-v1",
        "owlv2-base-sam2.1-tiny-cpu-v1"
      ]
    },
    "input": {
      "$ref": "#/$defs/source"
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "hint": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "xy"
          ],
          "properties": {
            "kind": {
              "const": "point"
            },
            "xy": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1920
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "xyxy"
          ],
          "properties": {
            "kind": {
              "const": "box"
            },
            "xyxy": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1920
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "text"
          ],
          "properties": {
            "kind": {
              "const": "text"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "width",
        "height"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "width": {
          "type": "integer",
          "minimum": 32,
          "maximum": 1920
        },
        "height": {
          "type": "integer",
          "minimum": 32,
          "maximum": 1920
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "key",
        "label"
      ],
      "properties": {
        "kind": {
          "enum": [
            "foreground",
            "prop",
            "face"
          ]
        },
        "key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "label": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          ]
        }
      }
    }
  }
}
