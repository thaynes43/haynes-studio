{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haynes-studio.invalid/schemas/studio.legacy-import.v1.schema.json",
  "title": "studio.legacy-import/v1: legacy-to-canonical import map (contract section 1)",
  "type": "object",
  "required": [
    "schema",
    "source_key",
    "production_id",
    "media_kind",
    "story_id",
    "draft_from_revision",
    "writes_legacy",
    "revisions"
  ],
  "properties": {
    "schema": {
      "const": "studio.legacy-import/v1",
      "x-studio": {
        "const": {
          "rule": "schema.unsupported",
          "message": "must be studio.legacy-import/v1"
        }
      }
    },
    "source_key": {
      "$ref": "studio.defs.v1.schema.json#/$defs/source_key"
    },
    "production_id": {
      "$ref": "studio.defs.v1.schema.json#/$defs/prd_id"
    },
    "media_kind": {
      "$ref": "studio.defs.v1.schema.json#/$defs/media_kind"
    },
    "story_id": {
      "$ref": "studio.defs.v1.schema.json#/$defs/sty_id"
    },
    "draft_from_revision": {
      "$ref": "studio.defs.v1.schema.json#/$defs/positive"
    },
    "writes_legacy": {
      "const": false
    },
    "revisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "legacy_revision",
          "revision_field_present",
          "manifest",
          "manifest_sha256",
          "job",
          "frames",
          "shots"
        ],
        "properties": {
          "legacy_revision": {
            "$ref": "studio.defs.v1.schema.json#/$defs/positive"
          },
          "revision_field_present": {
            "type": "boolean"
          },
          "manifest": {
            "type": "string",
            "minLength": 1
          },
          "manifest_sha256": {
            "$ref": "studio.defs.v1.schema.json#/$defs/sha256"
          },
          "speech_sha256": {
            "$ref": "studio.defs.v1.schema.json#/$defs/sha256"
          },
          "job": {
            "type": "string",
            "minLength": 1
          },
          "tracker": {
            "type": [
              "string",
              "null"
            ]
          },
          "imported_run_id": {
            "$ref": "studio.defs.v1.schema.json#/$defs/run_id_or_null"
          },
          "run_status": {
            "const": "imported"
          },
          "method": {
            "type": "object",
            "required": [
              "legacy"
            ],
            "properties": {
              "legacy": {
                "const": "rigid_cutout"
              }
            },
            "additionalProperties": false
          },
          "delivery_id": {
            "$ref": "studio.defs.v1.schema.json#/$defs/dlv_id_or_null"
          },
          "ledger_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{32}$",
            "maxLength": 32
          },
          "master_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$",
            "maxLength": 64
          },
          "frames": {
            "$ref": "studio.defs.v1.schema.json#/$defs/count"
          },
          "shots": {
            "$ref": "studio.defs.v1.schema.json#/$defs/count"
          }
        },
        "additionalProperties": false
      }
    },
    "story_records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_key",
          "kind",
          "id"
        ],
        "properties": {
          "source_key": {
            "$ref": "studio.defs.v1.schema.json#/$defs/source_key"
          },
          "kind": {
            "enum": [
              "bed",
              "asset_version"
            ]
          },
          "id": {
            "$ref": "studio.defs.v1.schema.json#/$defs/id"
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "bed"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "id": {
                  "$ref": "studio.defs.v1.schema.json#/$defs/cue_id"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "asset_version"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "id": {
                  "$ref": "studio.defs.v1.schema.json#/$defs/asv_id"
                }
              }
            }
          }
        ]
      }
    },
    "e0_deliveries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "ledger_id",
          "method"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "ledger_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$",
            "maxLength": 32
          },
          "method": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "imported_run_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hidden_candidates": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "not_imported": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "patternProperties": {
    "^boards_from_r[1-9][0-9]*$": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "legacy_shot",
          "board_id",
          "lines"
        ],
        "properties": {
          "legacy_shot": {
            "$ref": "studio.defs.v1.schema.json#/$defs/positive"
          },
          "board_id": {
            "$ref": "studio.defs.v1.schema.json#/$defs/brd_id"
          },
          "source_key": {
            "$ref": "studio.defs.v1.schema.json#/$defs/source_key"
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "legacy_k",
                "line_id"
              ],
              "properties": {
                "legacy_k": {
                  "$ref": "studio.defs.v1.schema.json#/$defs/count"
                },
                "line_id": {
                  "$ref": "studio.defs.v1.schema.json#/$defs/lin_id"
                },
                "source_key": {
                  "$ref": "studio.defs.v1.schema.json#/$defs/source_key"
                }
              },
              "additionalProperties": false
            }
          },
          "cues": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "source_key",
                "cue_id"
              ],
              "properties": {
                "source_key": {
                  "$ref": "studio.defs.v1.schema.json#/$defs/source_key"
                },
                "cue_id": {
                  "$ref": "studio.defs.v1.schema.json#/$defs/cue_id"
                }
              },
              "additionalProperties": false
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "source_key",
                "note_id"
              ],
              "properties": {
                "source_key": {
                  "$ref": "studio.defs.v1.schema.json#/$defs/source_key"
                },
                "note_id": {
                  "$ref": "studio.defs.v1.schema.json#/$defs/nte_id"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "description": "The draft's board map is boards_from_r<draft_from_revision> (the contract's r4 name, generalized; proposal). story_records holds IDs the contract map does not record (beds, asset versions) so a second import returns them."
}
