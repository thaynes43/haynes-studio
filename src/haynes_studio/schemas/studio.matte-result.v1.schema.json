{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haynes-studio.invalid/schemas/studio.matte-result.v1.schema.json",
  "title": "Studio still matting result (OP459)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "job_id",
    "source",
    "profile_id",
    "profile_sha256",
    "parameters",
    "input_signature",
    "artifacts",
    "shape",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "studio.matte-result/v1"
    },
    "job_id": {
      "$ref": "studio.job.v1.schema.json#/$defs/job_id"
    },
    "source": {
      "$ref": "studio.matte-request.v1.schema.json#/$defs/source"
    },
    "profile_id": {
      "const": "birefnet-lite-ort-cpu-v1"
    },
    "profile_sha256": {
      "$ref": "studio.defs.v1.schema.json#/$defs/sha256"
    },
    "parameters": {
      "$ref": "studio.matte-request.v1.schema.json#/$defs/parameters"
    },
    "input_signature": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "maxLength": 71
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cutout",
        "mask"
      ],
      "properties": {
        "cutout": {
          "$ref": "#/$defs/artifact"
        },
        "mask": {
          "$ref": "#/$defs/artifact"
        }
      }
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bbox_xyxy",
        "bbox_height_px",
        "foreground_area_px",
        "alpha_threshold",
        "scale"
      ],
      "properties": {
        "bbox_xyxy": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2048
          }
        },
        "bbox_height_px": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        },
        "foreground_area_px": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194303
        },
        "alpha_threshold": {
          "const": 128
        },
        "scale": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "numerator",
            "denominator"
          ],
          "properties": {
            "numerator": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2048
            },
            "denominator": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2048
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "source_revision",
        "files_sha256",
        "runtime",
        "provider",
        "image_digest",
        "parameters"
      ],
      "properties": {
        "model": {
          "const": "onnx-community/BiRefNet_lite-ONNX"
        },
        "source_revision": {
          "const": "de15b22ba131738a16dff04aab8bdf8dc32e3ac1"
        },
        "files_sha256": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model.onnx"
          ],
          "properties": {
            "model.onnx": {
              "$ref": "studio.defs.v1.schema.json#/$defs/sha256"
            }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version",
            "wheel_sha256"
          ],
          "properties": {
            "name": {
              "const": "onnxruntime"
            },
            "version": {
              "const": "1.32.0"
            },
            "wheel_sha256": {
              "$ref": "studio.defs.v1.schema.json#/$defs/sha256"
            }
          }
        },
        "provider": {
          "const": "CPUExecutionProvider"
        },
        "image_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "maxLength": 71
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input",
            "alpha",
            "png",
            "libraries",
            "session"
          ],
          "properties": {
            "input": {
              "type": "object",
              "minProperties": 1
            },
            "alpha": {
              "type": "object",
              "minProperties": 1
            },
            "png": {
              "type": "object",
              "minProperties": 1
            },
            "libraries": {
              "type": "object",
              "minProperties": 1
            },
            "session": {
              "type": "object",
              "minProperties": 1
            }
          }
        }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "bytes",
        "media_type",
        "width",
        "height"
      ],
      "properties": {
        "sha256": {
          "$ref": "studio.defs.v1.schema.json#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20971520
        },
        "media_type": {
          "const": "image/png"
        },
        "width": {
          "type": "integer",
          "minimum": 64,
          "maximum": 2048
        },
        "height": {
          "type": "integer",
          "minimum": 64,
          "maximum": 2048
        }
      }
    }
  }
}
