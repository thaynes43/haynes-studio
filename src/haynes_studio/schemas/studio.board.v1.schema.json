{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haynes-studio.invalid/schemas/studio.board.v1.schema.json",
  "title": "studio.board/v1: one board (contract sections 2, 3, 5, 6)",
  "type": "object",
  "required": [
    "schema",
    "id",
    "story_id",
    "number",
    "revision",
    "title",
    "lines",
    "timing",
    "voice",
    "photo",
    "cast",
    "layout",
    "method",
    "seeds",
    "cues",
    "notes",
    "drafted_by",
    "origin"
  ],
  "properties": {
    "schema": {
      "const": "studio.board/v1",
      "x-studio": {
        "const": {
          "rule": "schema.unsupported",
          "message": "must be studio.board/v1"
        }
      }
    },
    "id": {
      "$ref": "studio.defs.v1.schema.json#/$defs/brd_id"
    },
    "story_id": {
      "$ref": "studio.defs.v1.schema.json#/$defs/sty_id"
    },
    "number": {
      "$ref": "studio.defs.v1.schema.json#/$defs/positive"
    },
    "revision": {
      "$ref": "studio.defs.v1.schema.json#/$defs/positive"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "speaker",
          "text",
          "gap_before_ms"
        ],
        "properties": {
          "id": {
            "$ref": "studio.defs.v1.schema.json#/$defs/lin_id"
          },
          "speaker": {
            "$ref": "studio.defs.v1.schema.json#/$defs/speaker"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "gap_before_ms": true
        },
        "additionalProperties": false
      },
      "allOf": [
        {
          "prefixItems": [
            {
              "properties": {
                "gap_before_ms": {
                  "type": "null",
                  "x-studio": {
                    "type": {
                      "rule": "time.first_line_gap",
                      "message": "the first line starts at lead_ms; its gap must be null (TIME-2)"
                    }
                  }
                }
              }
            }
          ]
        },
        {
          "prefixItems": [
            true
          ],
          "items": {
            "properties": {
              "gap_before_ms": {
                "type": [
                  "integer",
                  "null"
                ],
                "not": {
                  "type": "null"
                },
                "minimum": 0,
                "x-studio": {
                  "type": {
                    "rule": "time.not_integer_ms",
                    "message": "must be integer milliseconds"
                  },
                  "not": {
                    "message": "a later line needs gap_before_ms (TIME-2)"
                  },
                  "minimum": {
                    "rule": "time.negative",
                    "message": "must not be negative"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "timing": {
      "type": "object",
      "required": [
        "lead_ms",
        "tail_ms",
        "hold_ms"
      ],
      "properties": {
        "lead_ms": true,
        "tail_ms": true,
        "hold_ms": true,
        "duration_ms": {
          "$ref": "studio.defs.v1.schema.json#/$defs/duration_is_derived"
        },
        "frames": {
          "$ref": "studio.defs.v1.schema.json#/$defs/duration_is_derived"
        },
        "content_ms": {
          "$ref": "studio.defs.v1.schema.json#/$defs/duration_is_derived"
        }
      },
      "additionalProperties": false
    },
    "duration_ms": {
      "$ref": "studio.defs.v1.schema.json#/$defs/duration_is_derived"
    },
    "voice": {
      "type": "object",
      "required": [
        "style",
        "current_version_id"
      ],
      "properties": {
        "style": true,
        "current_version_id": true
      },
      "additionalProperties": false
    },
    "photo": {
      "type": "object",
      "required": [
        "current_version_id",
        "prompt",
        "input_asset_version_ids"
      ],
      "properties": {
        "current_version_id": {
          "$ref": "studio.defs.v1.schema.json#/$defs/asv_id_or_null"
        },
        "prompt": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1800
        },
        "input_asset_version_ids": {
          "type": "array",
          "items": {
            "$ref": "studio.defs.v1.schema.json#/$defs/asv_id"
          }
        }
      },
      "additionalProperties": false
    },
    "cast": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "slot",
          "asset_version_id"
        ],
        "properties": {
          "slot": {
            "$ref": "studio.defs.v1.schema.json#/$defs/slot"
          },
          "asset_version_id": {
            "$ref": "studio.defs.v1.schema.json#/$defs/asv_id"
          }
        },
        "additionalProperties": false
      }
    },
    "layout": {
      "type": "object",
      "required": [
        "preset",
        "foreground"
      ],
      "properties": {
        "preset": {
          "type": "string",
          "minLength": 1
        },
        "foreground": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "method": {
      "type": "object",
      "required": [
        "layer",
        "motion"
      ],
      "properties": {
        "layer": {
          "enum": [
            "layered",
            "whole_frame"
          ],
          "x-studio": {
            "enum": {
              "rule": "method.unknown",
              "message": "layer must be layered or whole_frame (D38)"
            }
          }
        },
        "motion": {
          "enum": [
            "s2v",
            "i2v"
          ],
          "x-studio": {
            "enum": {
              "rule": "method.unknown",
              "message": "motion must be s2v or i2v (D38)"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "seeds": {
      "type": "object",
      "propertyNames": {
        "anyOf": [
          {
            "pattern": "^s2v:[a-z]$",
            "maxLength": 5
          },
          {
            "const": "i2v:frame"
          }
        ],
        "x-studio": {
          "anyOf": {
            "message": "seed keys are s2v:<slot> or i2v:frame (contract section 4)"
          }
        }
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "cues": {
      "type": "array",
      "items": {
        "$ref": "studio.defs.v1.schema.json#/$defs/board_cue"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "$ref": "studio.defs.v1.schema.json#/$defs/note"
      }
    },
    "drafted_by": {
      "$ref": "studio.defs.v1.schema.json#/$defs/principal"
    },
    "origin": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "source_key",
        "legacy_revision",
        "legacy_shot",
        "manifest"
      ],
      "properties": {
        "source_key": {
          "$ref": "studio.defs.v1.schema.json#/$defs/source_key"
        },
        "legacy_revision": {
          "$ref": "studio.defs.v1.schema.json#/$defs/positive"
        },
        "legacy_shot": {
          "$ref": "studio.defs.v1.schema.json#/$defs/positive"
        },
        "manifest": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "derived": {
      "type": "object",
      "required": [
        "timing_state",
        "content_ms",
        "frames",
        "film_start_frame",
        "voice_state",
        "photo_state"
      ],
      "properties": {
        "timing_state": {
          "enum": [
            "timed",
            "untimed"
          ]
        },
        "content_ms": {
          "$ref": "studio.defs.v1.schema.json#/$defs/frames_or_null"
        },
        "frames": {
          "$ref": "studio.defs.v1.schema.json#/$defs/frames_or_null"
        },
        "film_start_frame": {
          "$ref": "studio.defs.v1.schema.json#/$defs/frames_or_null"
        },
        "voice_state": {
          "enum": [
            "not_needed",
            "absent",
            "generating",
            "current",
            "stale"
          ]
        },
        "photo_state": {
          "enum": [
            "absent",
            "generating",
            "current",
            "stale"
          ]
        }
      },
      "additionalProperties": false
    },
    "created_at": {
      "$ref": "studio.defs.v1.schema.json#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "studio.defs.v1.schema.json#/$defs/timestamp"
    }
  },
  "$comment": "A board with lines is spoken (lead, tail, voice style; no hold), without lines silent (a hold of 100 to 120000 ms; no lead, tail or voice). Each branch checks the shape before any range, so a hold on a spoken board is always time.hold_on_spoken_board (contract sections 2 and 3, TIME-2 to TIME-5).",
  "if": {
    "properties": {
      "lines": {
        "minItems": 1
      }
    },
    "required": [
      "lines"
    ]
  },
  "then": {
    "properties": {
      "timing": {
        "properties": {
          "lead_ms": {
            "type": [
              "integer",
              "null"
            ],
            "not": {
              "type": "null"
            },
            "minimum": 0,
            "x-studio": {
              "type": {
                "rule": "time.not_integer_ms",
                "message": "must be integer milliseconds"
              },
              "not": {
                "message": "a spoken board needs lead_ms (TIME-3)"
              },
              "minimum": {
                "rule": "time.negative",
                "message": "must not be negative"
              }
            }
          },
          "tail_ms": {
            "type": [
              "integer",
              "null"
            ],
            "not": {
              "type": "null"
            },
            "minimum": 250,
            "x-studio": {
              "type": {
                "rule": "time.not_integer_ms",
                "message": "must be integer milliseconds"
              },
              "not": {
                "message": "a spoken board needs tail_ms (TIME-3)"
              },
              "minimum": {
                "rule": "time.tail_too_short",
                "message": "must be at least 250 ms (TIME-5)"
              }
            }
          },
          "hold_ms": {
            "type": "null",
            "x-studio": {
              "type": {
                "rule": "time.hold_on_spoken_board",
                "message": "a spoken board's length comes from its takes; hold must be null (TIME-4)"
              }
            }
          }
        }
      },
      "voice": {
        "properties": {
          "style": {
            "enum": [
              "cast",
              "narrator"
            ],
            "x-studio": {
              "enum": {
                "message": "a spoken board's voice style is cast or narrator"
              }
            }
          },
          "current_version_id": {
            "$ref": "studio.defs.v1.schema.json#/$defs/asv_id_or_null"
          }
        }
      }
    }
  },
  "else": {
    "properties": {
      "timing": {
        "properties": {
          "lead_ms": {
            "type": "null",
            "x-studio": {
              "type": {
                "message": "a silent board has a hold only; lead_ms must be null (TIME-4)"
              }
            }
          },
          "tail_ms": {
            "type": "null",
            "x-studio": {
              "type": {
                "message": "a silent board has a hold only; tail_ms must be null (TIME-4)"
              }
            }
          },
          "hold_ms": {
            "type": [
              "integer",
              "null"
            ],
            "not": {
              "type": "null"
            },
            "minimum": 100,
            "maximum": 120000,
            "x-studio": {
              "type": {
                "rule": "time.not_integer_ms",
                "message": "must be integer milliseconds"
              },
              "not": {
                "rule": "time.hold_out_of_range",
                "message": "a silent board needs a hold of 100 to 120000 ms (TIME-4)"
              },
              "minimum": {
                "rule": "time.hold_out_of_range",
                "message": "must be 100 to 120000 ms (TIME-4)"
              },
              "maximum": {
                "rule": "time.hold_out_of_range",
                "message": "must be 100 to 120000 ms (TIME-4)"
              }
            }
          }
        }
      },
      "voice": {
        "properties": {
          "style": {
            "type": "null",
            "x-studio": {
              "type": {
                "message": "a silent board has no voice; style must be null"
              }
            }
          },
          "current_version_id": {
            "type": "null",
            "x-studio": {
              "type": {
                "message": "a silent board has no voice; current_version_id must be null"
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
